# P16: outbound integrations never enable themselves. Exact HTTPS destinations,
# an operator-provisioned >=32-character signing secret and explicit live mode
# are all required. Default remains disabled; do not commit a real secret.
COLLABORATION_INTEGRATION_MODE=disabled
COLLABORATION_WEBHOOK_DESTINATIONS=[]
COLLABORATION_WEBHOOK_SECRET=
COLLABORATION_WEBHOOK_TIMEOUT_SECONDS=3
# Run python3 scripts/setup_dev.py; it creates .env with six independent hex64
# secrets and mode 0600. No defaults are usable. Never commit your .env.
# Bootstrap administrator (postgres); used only for database initialization.
POSTGRES_PASSWORD=
# app_owner owns elseview_app and its schema; migration connection only.
DB_OWNER_PASSWORD=
# app is the restricted runtime role, without schema creation rights.
DB_APP_PASSWORD=
# test_owner owns only elseview_test, for python -m app.test_runner.
DB_TEST_PASSWORD=
# Valkey authentication; hexadecimal avoids URI/config escaping ambiguity.
CACHE_PASSWORD=
# Application signing secret, generated independently of database credentials.
SECRET_KEY=

# Compose explicitly sets application settings (not interpolated from this file):
# APP_ENV=development; AI_MODE=mock; LOG_LEVEL=INFO; JOB_RUNNER_ENABLED=true
# P10: mock remains default and never calls a provider. Do not enable live casually.
# Live additionally requires exact model, explicit host/capability/privacy approvals
# and operator-verified Decimal pricing. Keep keys backend-only and out of git.
AI_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-v1
LLM_APPROVED_HOSTS=[]
LLM_PROFILE_APPROVED=false
LLM_PRIVACY_APPROVED=false
LLM_PRIVACY_RECORD=
LLM_CONFIG_REVISION=1
LLM_MODEL_REVISION=unspecified
LLM_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=1500
LLM_CONTEXT_LIMIT=16000
LLM_OUTPUT_PARAMETER=max_tokens
LLM_SUPPORTS_JSON_SCHEMA=false
LLM_SUPPORTS_JSON_OBJECT=false
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
LLM_OTHER_CHARGE_RESERVE=0
LLM_STUDY_BUDGET=1
LLM_WORKSPACE_DAILY_BUDGET=5
LLM_CURRENCY=USD
# Tests explicitly force JOB_RUNNER_ENABLED=false except owned lifespan tests.
# DATABASE_URL=postgresql+psycopg://app:<DB_APP_PASSWORD>@database:5432/elseview_app
# MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:<DB_OWNER_PASSWORD>@database:5432/elseview_app
# TEST_DATABASE_URL=postgresql+psycopg://test_owner:<DB_TEST_PASSWORD>@database:5432/elseview_test
# CACHE_URL=redis://:<CACHE_PASSWORD>@cache:6379/0
# PUBLIC_ORIGIN=http://localhost:8080; ALLOWED_ORIGINS=["http://localhost:8080"]
# PRIVATE_ROOT=/app/private; SECRET_KEY comes from above.
# Migration: scripts/dev exec -T backend python -m alembic upgrade head
# Tests: scripts/dev exec -T backend python -m app.test_runner
# Initialization applies only to new volumes. Changing .env does not rotate
# credentials in existing PostgreSQL data. Never automatically remove volumes.